NODE_ENV=development
NOME_APLICACAO=api-ordens-servico
PORTA_APLICACAO=3000
HOST_APLICACAO=0.0.0.0
PREFIXO_GLOBAL_API=api
FUSO_HORARIO_PADRAO=America/Sao_Paulo
NIVEL_LOG=log,debug,warn,error

URL_BANCO_DADOS=mysql://api_usuario:api_senha@mysql:3306/ordens_servico
URL_BANCO_DADOS_SOMBRA=mysql://api_usuario:api_senha@mysql:3306/ordens_servico_sombra
MYSQL_SENHA_ROOT=root
MYSQL_BANCO=ordens_servico
MYSQL_USUARIO=api_usuario
MYSQL_SENHA=api_senha
MYSQL_PORTA_PUBLICA=3306

REDIS_HOST=redis
REDIS_PORTA=6379
REDIS_PORTA_PUBLICA=6379
REDIS_SENHA=
REDIS_BANCO=0
REDIS_TLS=false

JWT_SEGREDO_ACESSO=troque-esta-chave-de-acesso
JWT_TEMPO_ACESSO=15m
JWT_SEGREDO_REFRESH=troque-esta-chave-de-refresh
JWT_TEMPO_REFRESH=30d
JWT_EMISSOR=api-ordens-servico
JWT_AUDIENCIA=frontend-ordens-servico

RODADAS_HASH_SENHA=10

AWS_ACCESS_KEY_ID=seu-access-key-id
AWS_SECRET_ACCESS_KEY=seu-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false
AWS_MAX_ATTEMPTS=3

S3_BUCKET_NAME=empresa-tapetes-persas
S3_PUBLIC_BASE_URL=
S3_UPLOAD_URL_EXPIRES_IN=900
S3_GET_URL_EXPIRES_IN=3600

BULLMQ_PREFIXO=ordens-servico
BULLMQ_REMOVER_CONCLUIDOS_SEGUNDOS=86400
BULLMQ_REMOVER_FALHAS_SEGUNDOS=604800
CAMINHO_BULL_BOARD=/admin/filas
PERFIS_BULL_BOARD=supervisor,master
CONCORRENCIA_FILA_IMAGEM=2
CONCORRENCIA_FILA_PDF=2
CONCORRENCIA_FILA_NOTIFICACAO=4

LIMITE_MB_ARQUIVO_IMAGEM=15
TIPOS_MIME_PERMITIDOS_IMAGEM=image/jpeg,image/png,image/webp,image/heic

DESCONTO_MAXIMO_FUNCIONARIO=10
DESCONTO_MAXIMO_SUPERVISOR=20
DESCONTO_MAXIMO_MASTER=100

PHPMYADMIN_PORTA=8080

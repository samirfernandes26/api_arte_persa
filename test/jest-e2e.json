{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test\\/(integration|e2e)\\/.*\\.(integration|e2e)-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/configuracao/global-setup.ts",
  "globalTeardown": "<rootDir>/test/configuracao/global-teardown.ts",
  "setupFiles": ["<rootDir>/test/configuracao/setup-env.ts"],
  "testTimeout": 120000,
  "openHandlesTimeout": 20000
}

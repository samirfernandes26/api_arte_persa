    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }

NODE_ENV=development
APP_NAME=api-arte-persa
APP_PORT=3000
APP_HOST=0.0.0.0
APP_GLOBAL_PREFIX=api
APP_FALLBACK_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=log,debug,warn,error

DATABASE_URL=mysql://app_user:app_password@mysql:3306/api_arte_persa
DATABASE_SHADOW_URL=mysql://app_user:app_password@mysql:3306/api_arte_persa_shadow
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=api_arte_persa
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_PUBLIC=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=api-arte-persa
JWT_AUDIENCE=api-arte-persa-web

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false
AWS_MAX_ATTEMPTS=3

S3_BUCKET_NAME=arte-persa-assets
S3_PUBLIC_BASE_URL=
S3_UPLOAD_URL_EXPIRES_IN=900
S3_GET_URL_EXPIRES_IN=3600

BULLMQ_PREFIX=api-arte-persa
BULLMQ_REMOVE_ON_COMPLETE_AGE=86400
BULLMQ_REMOVE_ON_FAIL_AGE=604800
BULL_BOARD_PATH=/admin/queues
BULL_BOARD_ALLOWED_ROLES=supervisor,master
QUEUE_CONCURRENCY_IMAGE=2
QUEUE_CONCURRENCY_PDF=2
QUEUE_CONCURRENCY_NOTIFICATION=4

IMAGE_MAX_FILE_SIZE_MB=15
SIGNED_URL_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic

PHPMYADMIN_PORT=8080
